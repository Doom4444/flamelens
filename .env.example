# ==============================================================================
# FlameLens Environment Configuration
#
# Copy to .env (never commit it). Only the production deployment variables are
# required; everything else has a safe default. See DEPLOYMENT.md for details.
# ==============================================================================

# Application
APP_NAME=FlameLens
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Binding (Render supplies PORT automatically)
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated or JSON list)
# Production: set this to the deployed frontend origin, e.g.
# CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Read-only metadata inventory directory.
# Defaults to <repo>/data/metadata; the production image uses /app/data/metadata.
FLAMELENS_METADATA_DIR=

# AI providers (optional). Leave empty to use the deterministic insight
# fallback. Keys are backend-only and must never be exposed to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama endpoint (optional, development only)
OLLAMA_BASE_URL=http://localhost:11434
