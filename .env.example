# ==============================================================================
# FlameLens Environment Configuration
# ==============================================================================

# Application
APP_NAME=FlameLens
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Binding
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (PostgreSQL + pgvector for Phase 3)
DATABASE_URL=postgresql+psycopg://flamelens:flamelens@localhost:5432/flamelens
POSTGRES_USER=flamelens
POSTGRES_PASSWORD=flamelens
POSTGRES_DB=flamelens
POSTGRES_PORT=5432

# AI Providers Configuration (for Phase 6)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
