# ==============================================================================
# FlameLens Frontend Environment Variables
#
# Copy to .env for local development (never commit it).
# Vite inlines these values at build time, so a new value requires a rebuild /
# redeploy of the frontend.
# ==============================================================================

# Local development default. Production builds must set this to the deployed
# backend origin (no trailing slash), for example:
# VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
